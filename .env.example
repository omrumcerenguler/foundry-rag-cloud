# Runtime mode: LOCAL (offline Foundry) or AZURE_CLOUD
RAG_MODE=LOCAL

# API authentication. Set a long random value in production.
API_KEY=replace-with-a-long-random-secret

# Persistent SQLite path inside the container.
DB_PATH=/app/data/rag.db
RAG_DATABASE_PATH=/app/data/rag.db

# Azure OpenAI settings (required only for AZURE_CLOUD).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-secret
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_EMBEDDING_DIMENSION=1536

# Local Foundry settings (required only for LOCAL).
FOUNDRY_MODEL_PATH=/models
LOCAL_EMBEDDING_MODEL=qwen3-embedding-0.6b
LOCAL_CHAT_MODEL=Phi-3.5-mini

RAG_CONFIDENCE_THRESHOLD=0.35
RAG_DATA_DIR=/app/data
API_PORT=8000
APP_PORT=8501
RAG_API_URL=http://api:8000
# Optional comma-separated browser origins for API access.
CORS_ALLOWED_ORIGINS=
